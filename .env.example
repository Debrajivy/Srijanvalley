# Copy this file to .env.local and add a newly rotated server-side key.
# Never use a VITE_ prefix for secrets: Vite exposes those values to browsers.
OPENAI_API_KEY=replace_with_your_rotated_key
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Server-only MongoDB and AI Tutor authentication settings.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=srijan_valley_ai_tutor
SESSION_SECRET=replace_with_a_long_random_secret
# Set to false in production after creating permanent accounts.
DEMO_AUTH_ENABLED=true
